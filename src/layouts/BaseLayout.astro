---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
}

const {
  title,
  description = 'Beyond BARS Coaching supports alcohol-free women—especially those who are system-impacted—in rebuilding safety, self-trust, and stability through trauma-informed coaching.',
  ogImage = '/logo.png',
  ogType = 'website',
  canonical,
} = Astro.props;

const GA_ID = 'G-WXNTXP1GRK';
const siteUrl = 'https://beyondbarscoaching.org';
const canonicalUrl = canonical ?? siteUrl + Astro.url.pathname;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ae97c9" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={siteUrl + ogImage} />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:site_name"   content="Beyond BARS Coaching" />

    <!-- Twitter / X -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={siteUrl + ogImage} />

    <!-- Favicons -->
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96x96.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />

    <!-- Google Fonts — preconnects + stylesheet in <head> so the font request
         fires in parallel with the main CSS, not after it (avoids @import chain) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;600;700;900&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&display=swap" />

    <!-- GA4 — placeholder; swap G-XXXXXXXXXX for real ID -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>
  </head>
  <body>
    <Nav />

    <!-- Cohort 1 enrollment banner: counts down to Dec 1 2026, then shows open through Jan 7 2027 -->
    <div id="cohort-banner" class="cohort-banner" style="display:none" aria-live="polite">
      <div class="cohort-banner-inner">
        <span id="cohort-banner-msg"></span>
        <a href="/cohorts" class="cohort-banner-btn">See All Cohorts</a>
        <button class="cohort-banner-close" aria-label="Dismiss banner" onclick="this.closest('#cohort-banner').style.display='none';sessionStorage.setItem('cohortBannerDismissed','1')">✕</button>
      </div>
    </div>

    <script>
      (function () {
        if (sessionStorage.getItem('cohortBannerDismissed')) return;

        const ENROLLMENT_OPEN  = new Date('2026-12-01T00:00:00');
        const ENROLLMENT_CLOSE = new Date('2027-01-08T00:00:00'); // Jan 7 end of day
        const now = new Date();

        const banner = document.getElementById('cohort-banner');
        const msg    = document.getElementById('cohort-banner-msg');
        if (!banner || !msg) return;

        if (now >= ENROLLMENT_CLOSE) return; // banner expired

        if (now >= ENROLLMENT_OPEN) {
          // Enrollment is open
          msg.innerHTML = '🎉 <strong>Cohort 1 Enrollment is Open!</strong> Join the January 12, 2027 cohort — spots are limited.';
          banner.style.display = '';
          banner.classList.add('is-open');
          return;
        }

        // Countdown mode
        banner.style.display = '';

        function tick() {
          const diff = ENROLLMENT_OPEN - new Date();
          if (diff <= 0) {
            msg.innerHTML = '🎉 <strong>Cohort 1 Enrollment is Open!</strong> Join the January 12, 2027 cohort — spots are limited.';
            banner.classList.add('is-open');
            return;
          }
          const d = Math.floor(diff / 86400000);
          const h = Math.floor((diff % 86400000) / 3600000);
          const m = Math.floor((diff % 3600000) / 60000);
          const s = Math.floor((diff % 60000) / 1000);
          msg.innerHTML =
            '📅 <strong>Cohort 1 Enrollment Opens December 1!</strong> ' +
            d + 'd ' + h + 'h ' + m + 'm ' + s + 's';
        }

        tick();
        setInterval(tick, 1000);
      })();
    </script>

    <!-- ── Holiday decor: snow + pine corners, Dec 1 – Jan 1 ──────── -->
    <div id="holiday-decor" aria-hidden="true" style="display:none;pointer-events:none;position:fixed;inset:0;z-index:9000;overflow:hidden;">

      <!-- Animated snow canvas -->
      <canvas id="snow-canvas" style="position:absolute;inset:0;width:100%;height:100%;"></canvas>

      <!-- Bottom-left pine branch -->
      <svg class="pine pine-bl" viewBox="0 0 320 260" xmlns="http://www.w3.org/2000/svg">
        <!-- main branch -->
        <path d="M0,260 Q60,200 140,140 Q200,100 280,60" stroke="#3b2a1a" stroke-width="7" fill="none" stroke-linecap="round"/>
        <!-- sub-branches -->
        <path d="M50,230 Q30,200 10,195" stroke="#3b2a1a" stroke-width="4" fill="none" stroke-linecap="round"/>
        <path d="M90,205 Q70,175 55,165" stroke="#3b2a1a" stroke-width="4" fill="none" stroke-linecap="round"/>
        <path d="M130,175 Q110,148 95,138" stroke="#3b2a1a" stroke-width="3.5" fill="none" stroke-linecap="round"/>
        <path d="M170,148 Q150,122 136,112" stroke="#3b2a1a" stroke-width="3" fill="none" stroke-linecap="round"/>
        <path d="M210,120 Q188,96 174,86" stroke="#3b2a1a" stroke-width="3" fill="none" stroke-linecap="round"/>
        <path d="M252,94 Q230,72 216,62" stroke="#3b2a1a" stroke-width="2.5" fill="none" stroke-linecap="round"/>
        <!-- needle clusters - left sub -->
        <g fill="#063831" opacity="0.9">
          <ellipse cx="8" cy="193" rx="18" ry="6" transform="rotate(-30 8 193)"/>
          <ellipse cx="14" cy="197" rx="16" ry="5" transform="rotate(10 14 197)"/>
          <ellipse cx="4" cy="200" rx="14" ry="4" transform="rotate(-55 4 200)"/>
        </g>
        <!-- needle clusters - 2nd sub -->
        <g fill="#063831" opacity="0.9">
          <ellipse cx="52" cy="163" rx="20" ry="6" transform="rotate(-40 52 163)"/>
          <ellipse cx="60" cy="168" rx="17" ry="5" transform="rotate(5 60 168)"/>
          <ellipse cx="45" cy="170" rx="15" ry="4" transform="rotate(-65 45 170)"/>
        </g>
        <!-- sage highlight needles -->
        <g fill="#688662" opacity="0.7">
          <ellipse cx="10" cy="191" rx="10" ry="3" transform="rotate(-30 10 191)"/>
          <ellipse cx="55" cy="161" rx="11" ry="3" transform="rotate(-40 55 161)"/>
        </g>
        <!-- needle clusters - 3rd sub -->
        <g fill="#063831" opacity="0.9">
          <ellipse cx="93" cy="136" rx="20" ry="6" transform="rotate(-45 93 136)"/>
          <ellipse cx="102" cy="142" rx="17" ry="5" transform="rotate(0 102 142)"/>
          <ellipse cx="86" cy="143" rx="14" ry="4" transform="rotate(-70 86 143)"/>
        </g>
        <g fill="#688662" opacity="0.65">
          <ellipse cx="96" cy="133" rx="10" ry="3" transform="rotate(-45 96 133)"/>
        </g>
        <!-- needle clusters - 4th sub -->
        <g fill="#063831" opacity="0.85">
          <ellipse cx="133" cy="110" rx="18" ry="5" transform="rotate(-50 133 110)"/>
          <ellipse cx="143" cy="116" rx="15" ry="4.5" transform="rotate(-5 143 116)"/>
          <ellipse cx="126" cy="117" rx="13" ry="4" transform="rotate(-75 126 117)"/>
        </g>
        <!-- needle clusters - 5th -->
        <g fill="#063831" opacity="0.8">
          <ellipse cx="172" cy="84" rx="16" ry="5" transform="rotate(-55 172 84)"/>
          <ellipse cx="181" cy="90" rx="14" ry="4" transform="rotate(-8 181 90)"/>
        </g>
        <g fill="#688662" opacity="0.6">
          <ellipse cx="175" cy="82" rx="9" ry="3" transform="rotate(-55 175 82)"/>
        </g>
        <!-- needle clusters - 6th -->
        <g fill="#063831" opacity="0.75">
          <ellipse cx="213" cy="60" rx="15" ry="4.5" transform="rotate(-55 213 60)"/>
          <ellipse cx="222" cy="66" rx="12" ry="4" transform="rotate(-10 222 66)"/>
        </g>
        <!-- main branch needles -->
        <g fill="#063831" opacity="0.5">
          <ellipse cx="100" cy="175" rx="12" ry="3.5" transform="rotate(50 100 175)"/>
          <ellipse cx="155" cy="143" rx="11" ry="3" transform="rotate(48 155 143)"/>
          <ellipse cx="200" cy="115" rx="10" ry="3" transform="rotate(45 200 115)"/>
        </g>
        <!-- pinecone at branch junction -->
        <g transform="translate(72,195) rotate(-35)">
          <ellipse cx="0" cy="0" rx="8" ry="13" fill="#7a5230"/>
          <path d="M-8,2 Q0,-4 8,2" stroke="#5a3a1a" stroke-width="1.5" fill="none"/>
          <path d="M-8,-2 Q0,-8 8,-2" stroke="#5a3a1a" stroke-width="1.5" fill="none"/>
          <path d="M-7,6 Q0,0 7,6" stroke="#5a3a1a" stroke-width="1.5" fill="none"/>
          <path d="M-5,10 Q0,5 5,10" stroke="#5a3a1a" stroke-width="1" fill="none"/>
        </g>
        <!-- small pinecone on main branch -->
        <g transform="translate(42,222) rotate(-20)">
          <ellipse cx="0" cy="0" rx="5" ry="8" fill="#8B6232"/>
          <path d="M-5,1 Q0,-3 5,1" stroke="#5a3a1a" stroke-width="1" fill="none"/>
          <path d="M-5,-2 Q0,-6 5,-2" stroke="#5a3a1a" stroke-width="1" fill="none"/>
          <path d="M-4,4 Q0,0 4,4" stroke="#5a3a1a" stroke-width="1" fill="none"/>
        </g>
        <!-- dusting of snow on some needles -->
        <g fill="white" opacity="0.55">
          <ellipse cx="12" cy="190" rx="7" ry="2.5" transform="rotate(-30 12 190)"/>
          <ellipse cx="57" cy="160" rx="8" ry="2" transform="rotate(-40 57 160)"/>
          <ellipse cx="97" cy="132" rx="7" ry="2" transform="rotate(-45 97 132)"/>
        </g>
      </svg>

      <!-- Bottom-right pine branch (mirror) -->
      <svg class="pine pine-br" viewBox="0 0 320 260" xmlns="http://www.w3.org/2000/svg" style="transform:scaleX(-1)">
        <!-- reuse exact same art, mirrored -->
        <path d="M0,260 Q60,200 140,140 Q200,100 280,60" stroke="#3b2a1a" stroke-width="7" fill="none" stroke-linecap="round"/>
        <path d="M50,230 Q30,200 10,195" stroke="#3b2a1a" stroke-width="4" fill="none" stroke-linecap="round"/>
        <path d="M90,205 Q70,175 55,165" stroke="#3b2a1a" stroke-width="4" fill="none" stroke-linecap="round"/>
        <path d="M130,175 Q110,148 95,138" stroke="#3b2a1a" stroke-width="3.5" fill="none" stroke-linecap="round"/>
        <path d="M170,148 Q150,122 136,112" stroke="#3b2a1a" stroke-width="3" fill="none" stroke-linecap="round"/>
        <path d="M210,120 Q188,96 174,86" stroke="#3b2a1a" stroke-width="3" fill="none" stroke-linecap="round"/>
        <path d="M252,94 Q230,72 216,62" stroke="#3b2a1a" stroke-width="2.5" fill="none" stroke-linecap="round"/>
        <g fill="#063831" opacity="0.9"><ellipse cx="8" cy="193" rx="18" ry="6" transform="rotate(-30 8 193)"/><ellipse cx="14" cy="197" rx="16" ry="5" transform="rotate(10 14 197)"/><ellipse cx="4" cy="200" rx="14" ry="4" transform="rotate(-55 4 200)"/></g>
        <g fill="#063831" opacity="0.9"><ellipse cx="52" cy="163" rx="20" ry="6" transform="rotate(-40 52 163)"/><ellipse cx="60" cy="168" rx="17" ry="5" transform="rotate(5 60 168)"/><ellipse cx="45" cy="170" rx="15" ry="4" transform="rotate(-65 45 170)"/></g>
        <g fill="#688662" opacity="0.7"><ellipse cx="10" cy="191" rx="10" ry="3" transform="rotate(-30 10 191)"/><ellipse cx="55" cy="161" rx="11" ry="3" transform="rotate(-40 55 161)"/></g>
        <g fill="#063831" opacity="0.9"><ellipse cx="93" cy="136" rx="20" ry="6" transform="rotate(-45 93 136)"/><ellipse cx="102" cy="142" rx="17" ry="5" transform="rotate(0 102 142)"/><ellipse cx="86" cy="143" rx="14" ry="4" transform="rotate(-70 86 143)"/></g>
        <g fill="#688662" opacity="0.65"><ellipse cx="96" cy="133" rx="10" ry="3" transform="rotate(-45 96 133)"/></g>
        <g fill="#063831" opacity="0.85"><ellipse cx="133" cy="110" rx="18" ry="5" transform="rotate(-50 133 110)"/><ellipse cx="143" cy="116" rx="15" ry="4.5" transform="rotate(-5 143 116)"/><ellipse cx="126" cy="117" rx="13" ry="4" transform="rotate(-75 126 117)"/></g>
        <g fill="#063831" opacity="0.8"><ellipse cx="172" cy="84" rx="16" ry="5" transform="rotate(-55 172 84)"/><ellipse cx="181" cy="90" rx="14" ry="4" transform="rotate(-8 181 90)"/></g>
        <g fill="#688662" opacity="0.6"><ellipse cx="175" cy="82" rx="9" ry="3" transform="rotate(-55 175 82)"/></g>
        <g fill="#063831" opacity="0.75"><ellipse cx="213" cy="60" rx="15" ry="4.5" transform="rotate(-55 213 60)"/><ellipse cx="222" cy="66" rx="12" ry="4" transform="rotate(-10 222 66)"/></g>
        <g fill="#063831" opacity="0.5"><ellipse cx="100" cy="175" rx="12" ry="3.5" transform="rotate(50 100 175)"/><ellipse cx="155" cy="143" rx="11" ry="3" transform="rotate(48 155 143)"/><ellipse cx="200" cy="115" rx="10" ry="3" transform="rotate(45 200 115)"/></g>
        <g transform="translate(72,195) rotate(-35)"><ellipse cx="0" cy="0" rx="8" ry="13" fill="#7a5230"/><path d="M-8,2 Q0,-4 8,2" stroke="#5a3a1a" stroke-width="1.5" fill="none"/><path d="M-8,-2 Q0,-8 8,-2" stroke="#5a3a1a" stroke-width="1.5" fill="none"/><path d="M-7,6 Q0,0 7,6" stroke="#5a3a1a" stroke-width="1.5" fill="none"/><path d="M-5,10 Q0,5 5,10" stroke="#5a3a1a" stroke-width="1" fill="none"/></g>
        <g transform="translate(42,222) rotate(-20)"><ellipse cx="0" cy="0" rx="5" ry="8" fill="#8B6232"/><path d="M-5,1 Q0,-3 5,1" stroke="#5a3a1a" stroke-width="1" fill="none"/><path d="M-5,-2 Q0,-6 5,-2" stroke="#5a3a1a" stroke-width="1" fill="none"/><path d="M-4,4 Q0,0 4,4" stroke="#5a3a1a" stroke-width="1" fill="none"/></g>
        <g fill="white" opacity="0.55"><ellipse cx="12" cy="190" rx="7" ry="2.5" transform="rotate(-30 12 190)"/><ellipse cx="57" cy="160" rx="8" ry="2" transform="rotate(-40 57 160)"/><ellipse cx="97" cy="132" rx="7" ry="2" transform="rotate(-45 97 132)"/></g>
      </svg>
    </div>

    <style>
      .pine {
        position: absolute;
        bottom: 0;
        width: 320px;
        height: 260px;
        opacity: 0.88;
      }
      .pine-bl { left: 0; }
      .pine-br { right: 0; }
      @media (max-width: 600px) {
        .pine { width: 200px; height: 162px; }
      }
    </style>

    <script>
      (function () {
        const DECOR_START = new Date('2026-12-01T00:00:00');
        const DECOR_END   = new Date('2027-01-02T00:00:00');
        const now = new Date();
        if (now < DECOR_START || now >= DECOR_END) return;

        const wrap = document.getElementById('holiday-decor');
        if (!wrap) return;
        wrap.style.display = '';

        // Snow
        const canvas = document.getElementById('snow-canvas') as HTMLCanvasElement;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        let W = window.innerWidth, H = window.innerHeight;
        canvas.width = W; canvas.height = H;
        window.addEventListener('resize', () => {
          W = window.innerWidth; H = window.innerHeight;
          canvas.width = W; canvas.height = H;
        });

        const FLAKES = 90;
        const flakes = Array.from({ length: FLAKES }, () => ({
          x: Math.random() * W,
          y: Math.random() * H,
          r: 1.5 + Math.random() * 3,
          speed: 0.4 + Math.random() * 1.1,
          drift: (Math.random() - 0.5) * 0.4,
          opacity: 0.4 + Math.random() * 0.5,
        }));

        function draw() {
          ctx.clearRect(0, 0, W, H);
          flakes.forEach(f => {
            ctx.beginPath();
            ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(255,255,255,${f.opacity})`;
            ctx.fill();
            f.y += f.speed;
            f.x += f.drift;
            if (f.y > H + f.r) { f.y = -f.r; f.x = Math.random() * W; }
            if (f.x > W + f.r) f.x = -f.r;
            if (f.x < -f.r) f.x = W + f.r;
          });
          requestAnimationFrame(draw);
        }
        draw();
      })();
    </script>

    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
