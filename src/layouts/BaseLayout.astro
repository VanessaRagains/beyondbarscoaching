---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
}

const {
  title,
  description = 'Beyond BARS Coaching supports alcohol-free women—especially those who are system-impacted—in rebuilding safety, self-trust, and stability through trauma-informed coaching.',
  ogImage = '/logo.png',
  ogType = 'website',
  canonical,
} = Astro.props;

const GA_ID = 'G-WXNTXP1GRK';
const siteUrl = 'https://beyondbarscoaching.org';
const canonicalUrl = canonical ?? siteUrl + Astro.url.pathname;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ae97c9" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={siteUrl + ogImage} />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:site_name"   content="Beyond BARS Coaching" />

    <!-- Twitter / X -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={siteUrl + ogImage} />

    <!-- Favicons -->
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96x96.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />

    <!-- Google Fonts — preconnects + stylesheet in <head> so the font request
         fires in parallel with the main CSS, not after it (avoids @import chain) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;600;700;900&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&display=swap" />

    <!-- GA4 — placeholder; swap G-XXXXXXXXXX for real ID -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>
  </head>
  <body>
    <Nav />

    <!-- Cohort 1 enrollment banner: counts down to Dec 1 2026, then shows open through Jan 7 2027 -->
    <div id="cohort-banner" class="cohort-banner" style="display:none" aria-live="polite">
      <div class="cohort-banner-inner">
        <span id="cohort-banner-msg"></span>
        <a href="/cohorts" class="cohort-banner-btn">See All Cohorts</a>
        <button class="cohort-banner-close" aria-label="Dismiss banner" onclick="this.closest('#cohort-banner').style.display='none';sessionStorage.setItem('cohortBannerDismissed','1')">✕</button>
      </div>
    </div>

    <script>
      (function () {
        if (sessionStorage.getItem('cohortBannerDismissed')) return;

        const ENROLLMENT_OPEN  = new Date('2026-12-01T00:00:00');
        const ENROLLMENT_CLOSE = new Date('2027-01-08T00:00:00'); // Jan 7 end of day
        const now = new Date();

        const banner = document.getElementById('cohort-banner');
        const msg    = document.getElementById('cohort-banner-msg');
        if (!banner || !msg) return;

        if (now >= ENROLLMENT_CLOSE) return; // banner expired

        if (now >= ENROLLMENT_OPEN) {
          // Enrollment is open
          msg.innerHTML = '🎉 <strong>Cohort 1 Enrollment is Open!</strong> Join the January 12, 2027 cohort — spots are limited.';
          banner.style.display = '';
          banner.classList.add('is-open');
          return;
        }

        // Countdown mode
        banner.style.display = '';

        function tick() {
          const diff = ENROLLMENT_OPEN - new Date();
          if (diff <= 0) {
            msg.innerHTML = '🎉 <strong>Cohort 1 Enrollment is Open!</strong> Join the January 12, 2027 cohort — spots are limited.';
            banner.classList.add('is-open');
            return;
          }
          const d = Math.floor(diff / 86400000);
          const h = Math.floor((diff % 86400000) / 3600000);
          const m = Math.floor((diff % 3600000) / 60000);
          const s = Math.floor((diff % 60000) / 1000);
          msg.innerHTML =
            '📅 <strong>Cohort 1 Enrollment Opens December 1!</strong> ' +
            d + 'd ' + h + 'h ' + m + 'm ' + s + 's';
        }

        tick();
        setInterval(tick, 1000);
      })();
    </script>

    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
