---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;

const cohorts = [
  {
    number: 1,
    start: "January 12, 2027",
    end: "April 11, 2027",
    enrollmentOpen: "December 1, 2026",
    enrollmentCloses: "January 7, 2027",
    integrationCalls: ["Wednesday, February 3", "Wednesday, March 3", "Wednesday, March 31"],
    accent: "accent-teal",
    status: "enrolling", // enrolling | coming-soon | closed
  },
  {
    number: 2,
    start: "May 4, 2027",
    end: "August 1, 2027",
    enrollmentOpen: "March 23, 2027",
    enrollmentCloses: "April 29, 2027",
    integrationCalls: ["Wednesday, May 26", "Wednesday, June 23", "Wednesday, July 21"],
    accent: "accent-purple",
    status: "coming-soon",
  },
  {
    number: 3,
    start: "August 17, 2027",
    end: "November 14, 2027",
    enrollmentOpen: "July 6, 2027",
    enrollmentCloses: "August 12, 2027",
    integrationCalls: ["Wednesday, September 8", "Wednesday, October 6", "Wednesday, November 3"],
    accent: "accent-gold",
    status: "coming-soon",
  },
];

// Replace this with your real Google Form link when ready
const REGISTRATION_FORM = "https://docs.google.com/forms/d/e/1FAIpQLSfy1H7JxP4Bt5CCJz8qJ77Eb5kz5uNmn7GHEz7FX4L98ybReg/viewform";
---

<BaseLayout
  title="2027 Cohorts | Beyond BARS Coaching"
  description="Join a Beyond BARS Coaching cohort in 2027 — a 90-day guided reentry program for system-impacted women choosing sobriety and stability. Three cohorts available."
>

  <!-- Hero -->
  <section class="hero-cohorts">
    <div class="container text-center">
      <h1>2027 Beyond BARS Cohorts</h1>
      <p class="hero-sub">
        A 90-day guided coaching journey for system-impacted women transitioning
        from incarceration, rehab, or group homes — choosing sobriety,
        stability, and a life with purpose.
      </p>
      <div class="divider"></div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="section-sm bg-soft">
    <div class="container">
      <div class="how-grid">
        <div class="how-step">
          <div class="how-num">1</div>
          <div>
            <h3>Register</h3>
            <p>Fill out the registration form for your chosen cohort. Registration is required — meeting links are never shared publicly.</p>
          </div>
        </div>
        <div class="how-step">
          <div class="how-num">2</div>
          <div>
            <h3>Get Your Invite</h3>
            <p>Once approved, you'll receive a private calendar invite with your secure meeting link — straight to your email.</p>
          </div>
        </div>
        <div class="how-step">
          <div class="how-num">3</div>
          <div>
            <h3>Show Up</h3>
            <p>Join every Tuesday for 13 weeks plus three Wednesday Integration Calls. Bring your workbook and your whole self.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cohort Cards -->
  <section class="section">
    <div class="container">
      <div class="cohorts-list">
        {cohorts.map((cohort) => (
          <div class={`cohort-card card ${cohort.accent}`}>
            <div class="cohort-header">
              <div>
                <span class="cohort-label">Cohort {cohort.number}</span>
                <h2>{cohort.start} – {cohort.end}</h2>
              </div>
              {cohort.status === "enrolling" && (
                <span class="badge badge-open">Enrollment Open</span>
              )}
              {cohort.status === "coming-soon" && (
                <span class="badge badge-soon">Coming Soon</span>
              )}
            </div>

            <div class="cohort-body">
              <div class="cohort-details">
                <div class="detail-row">
                  <span class="detail-label">📅 Enrollment opens</span>
                  <span>{cohort.enrollmentOpen}</span>
                </div>
                <div class="detail-row">
                  <span class="detail-label">⏰ Last day to register</span>
                  <span>{cohort.enrollmentCloses}</span>
                </div>
                <div class="detail-row">
                  <span class="detail-label">📞 Integration Calls</span>
                  <span class="calls-list">
                    {cohort.integrationCalls.map((call) => (
                      <span class="call-date">{call}</span>
                    ))}
                  </span>
                </div>
              </div>

              <div class="cohort-cta">
                {cohort.status === "enrolling" ? (
                  <a href={REGISTRATION_FORM} target="_blank" rel="noopener" class="btn btn-primary">
                    Register for Cohort {cohort.number}
                  </a>
                ) : (
                  <button class="btn btn-secondary" disabled>
                    Enrollment Opens {cohort.enrollmentOpen}
                  </button>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="section bg-soft">
    <div class="container text-center">
      <h2 class="section-heading">What's Included in Every Cohort</h2>
      <div class="divider"></div>
      <div class="includes-grid grid-3">
        <div class="include-item card card-body accent-teal">
          <div class="include-icon">📅</div>
          <h3>13 Weekly Sessions</h3>
          <p>Every Tuesday for 90 days — structured, consistent, and built around your real life.</p>
        </div>
        <div class="include-item card card-body accent-purple">
          <div class="include-icon">📞</div>
          <h3>3 Integration Calls</h3>
          <p>Wednesday deep-dives at weeks 4, 8, and 12 to process what's coming up and adjust your plan.</p>
        </div>
        <div class="include-item card card-body accent-gold">
          <div class="include-icon">📖</div>
          <h3>The Workbook</h3>
          <p>Your First 90 Days Beyond BARS — coaching exercises, planner, journal prompts, yoga, and breathing tools.</p>
        </div>
        <div class="include-item card card-body accent-sage">
          <div class="include-icon">💬</div>
          <h3>Text-Based Support</h3>
          <p>Between-session check-ins so you're never waiting until next Tuesday when something comes up.</p>
        </div>
        <div class="include-item card card-body accent-brand">
          <div class="include-icon">🛟</div>
          <h3>Private Access Only</h3>
          <p>Meeting links go only to registered participants — never posted publicly. Your safety is the priority.</p>
        </div>
        <div class="include-item card card-body accent-green">
          <div class="include-icon">🌿</div>
          <h3>Community</h3>
          <p>You're not doing this alone. Your cohort is your crew — the people who get it because they're living it too.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Workbook nudge -->
  <section class="section-sm">
    <div class="container">
      <div class="workbook-nudge card card-body accent-gold">
        <div class="nudge-inner">
          <div class="nudge-text">
            <h3>📖 Get Your Workbook Before Day One</h3>
            <p>Every cohort member needs <em>Your First 90 Days Beyond BARS</em> workbook. Order yours now so it arrives before your start date. Every purchase funds a free copy for someone who can't afford one.</p>
          </div>
          <div class="nudge-cta">
            <div class="nudge-price">$22.99</div>
            <a href={`${base}workbook`} class="btn btn-primary">Buy the Workbook</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Questions -->
  <section class="section-sm bg-soft text-center">
    <div class="container">
      <h2 class="section-heading">Questions?</h2>
      <p style="color: var(--color-text-light); max-width: 520px; margin-inline: auto; margin-bottom: var(--space-6);">
        Not sure which cohort is right for you, or want to learn more before registering?
        Reach out — we're happy to help you figure out the best fit.
      </p>
      <div class="contact-row">
        <a href="sms:+16503076592" class="btn btn-secondary">Text (650) 307-6592</a>
        <a href="mailto:Vanessa.Ragains@gmail.com" class="btn btn-secondary">Send an Email</a>
        <a href={`${base}book-a-call`} class="btn btn-primary">Book a Free Call</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
.hero-cohorts {
  background: linear-gradient(160deg, var(--color-brand-subtle) 0%, #fff 70%);
  padding-block: var(--space-14);
}
.hero-cohorts h1 { font-size: var(--text-4xl); margin-bottom: var(--space-4); }
.hero-sub { font-size: var(--text-lg); color: var(--color-text-light); max-width: 620px; margin-inline: auto; }

/* How it works */
.how-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8); }
.how-step { display: flex; gap: var(--space-4); align-items: flex-start; }
.how-num {
  flex-shrink: 0;
  width: 2.5rem; height: 2.5rem;
  background: var(--color-brand);
  color: #fff;
  border-radius: var(--radius-full);
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: var(--text-lg);
}
.how-step h3 { font-size: var(--text-lg); margin-bottom: var(--space-1); }
.how-step p { color: var(--color-text-light); font-size: var(--text-sm); margin: 0; }

/* Cohort cards */
.cohorts-list { display: flex; flex-direction: column; gap: var(--space-6); }
.cohort-card { border-left: 5px solid transparent; padding: var(--space-6) var(--space-8); }
.accent-teal   { border-left-color: var(--color-teal); }
.accent-purple { border-left-color: var(--color-brand-dark); }
.accent-gold   { border-left-color: var(--color-gold); }
.accent-sage   { border-left-color: var(--color-sage); }
.accent-brand  { border-left-color: var(--color-brand); }
.accent-green  { border-left-color: var(--color-green-dark); }

.cohort-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--space-5); flex-wrap: wrap; gap: var(--space-3); }
.cohort-label { display: block; font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-brand); margin-bottom: var(--space-1); }
.cohort-header h2 { font-size: var(--text-2xl); margin: 0; }

.badge { display: inline-block; padding: 0.3rem 0.9rem; border-radius: var(--radius-full); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
.badge-open { background: var(--color-teal); color: #fff; }
.badge-soon { background: var(--color-brand-subtle); color: var(--color-brand-dark); }

.cohort-body { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-8); flex-wrap: wrap; }
.cohort-details { flex: 1; display: flex; flex-direction: column; gap: var(--space-3); }
.detail-row { display: flex; gap: var(--space-4); font-size: var(--text-sm); flex-wrap: wrap; }
.detail-label { font-weight: 700; color: var(--color-text); min-width: 180px; }
.calls-list { display: flex; flex-direction: column; gap: var(--space-1); }
.call-date { color: var(--color-text-light); }
.cohort-cta { flex-shrink: 0; }

/* Includes grid */
.includes-grid { margin-top: var(--space-10); text-align: left; }
.include-icon { font-size: 2rem; margin-bottom: var(--space-3); }
.include-item h3 { font-size: var(--text-lg); margin-bottom: var(--space-2); }
.include-item p { color: var(--color-text-light); font-size: var(--text-sm); margin: 0; }

/* Workbook nudge */
.workbook-nudge { border-left: 5px solid var(--color-gold); }
.nudge-inner { display: flex; gap: var(--space-8); align-items: center; }
.nudge-text { flex: 1; }
.nudge-text h3 { font-size: var(--text-xl); margin-bottom: var(--space-2); }
.nudge-text p { color: var(--color-text-light); margin: 0; }
.nudge-cta { text-align: center; flex-shrink: 0; }
.nudge-price { font-family: var(--font-heading); font-size: var(--text-3xl); font-weight: 700; color: var(--color-brand-dark); margin-bottom: var(--space-3); }

/* Contact row */
.contact-row { display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap; }

button:disabled { opacity: 0.5; cursor: not-allowed; }

@media (max-width: 900px) {
  .how-grid { grid-template-columns: 1fr; }
  .cohort-body { flex-direction: column; align-items: flex-start; }
  .nudge-inner { flex-direction: column; }
  .nudge-cta { width: 100%; }
}
@media (max-width: 560px) {
  .hero-cohorts h1 { font-size: var(--text-3xl); }
  .cohort-card { padding: var(--space-5); }
  .cohort-header h2 { font-size: var(--text-xl); }
  .detail-label { min-width: unset; width: 100%; }
}
</style>
