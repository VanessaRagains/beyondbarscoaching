---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import VanessaImage from '../assets/vanessa-ragains.jpg';
import JessieImage from '../assets/board-jessie.jpg';
import HaileyImage from '../assets/board-hailey.jpg';
import FastMethod from '../assets/fast-method.png';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Beyond BARS Coaching"
  description="Beyond BARS Coaching supports alcohol-free women—especially those who are system-impacted—in rebuilding safety, self-trust, and stability through trauma-informed coaching, nervous-system education, and community connection."
>

  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container text-center">
      <div class="hero-text" style="text-align:center;">
        <h1>Hi Rebel! Welcome to Beyond BARS Coaching!</h1>
        <p class="hero-tagline">
          I support alcohol-free women—especially those who are system-impacted—in rebuilding safety,
          self-trust, and stability through trauma-informed coaching, nervous-system education, and
          community connection.
        </p>
        <div class="hero-links" style="display:flex; flex-direction:column; align-items:center; gap:var(--space-3);">
          <a href="https://docs.google.com/forms/d/e/1FAIpQLSfy1H7JxP4Bt5CCJz8qJ77Eb5kz5uNmn7GHEz7FX4L98ybReg/viewform" target="_blank" rel="noopener" class="btn btn-primary">
            Fill Out Registration Form
          </a>
          <a href={`${base}choose-your-impact`} class="btn btn-secondary">💛 Choose Your Impact</a>
        </div>

        <!-- YouTube live embed — shows automatically when Coach Veeeee goes live -->
        <div id="yt-live-wrap" class="yt-live-wrap">
          <p class="yt-live-schedule">🎁 Coach V is going LIVE on YouTube for <strong>Giving Tuesday, December 1st</strong> at <strong>9:15am · 11am · 2pm · 6:15pm</strong></p>
          <p class="yt-live-label">🔴 <strong>LIVE</strong> — Coach V is on YouTube right now!</p>
          <div class="yt-live-frame">
            <iframe
              src="https://www.youtube.com/embed/live_stream?channel=UCDhf4KO5MYC-pJ7RSE7l1fA&autoplay=0"
              title="Beyond BARS Coaching Live Stream"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="yt-live-actions">
            <a href="https://givebutter.com/c/6k46yrs" target="_blank" rel="noopener" class="btn yt-donate-btn">
              💛 Donate Now — Giving Tuesday
            </a>
            <a href="https://www.youtube.com/@vanessaragains" target="_blank" rel="noopener" class="yt-live-link">
              Watch on YouTube →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Giving Tuesday spotlight ─────────────────────────────────── -->
  <section class="section-sm gt-spotlight">
    <div class="container">
      <div class="gt-card">
        <div class="gt-card-text">
          <p class="gt-eyebrow">🎁 Giving Tuesday · December 1, 2026</p>
          <h2>$6K for 6 Years of Impact</h2>
          <p>Six years of walking alongside women rebuilding their lives beyond bars. Help us celebrate — and fund the next chapter.</p>
        </div>
        <div class="gt-card-cta">
          <a href="/giving-tuesday" class="btn btn-primary">See the Campaign →</a>
          <a href="https://givebutter.com/c/6k46yrs" target="_blank" rel="noopener" class="btn btn-secondary">Donate on GiveButter</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Mission ───────────────────────────────────────────────────── -->
  <section class="section bg-soft">
    <div class="container text-center">
      <div class="divider"></div>
      <h2 class="section-heading">Our Mission</h2>
      <p class="mission-statement">
        Sustainable sobriety and successful reentry are not created through willpower or punishment,
        but through <strong>structure, safety, and support.</strong>
      </p>
      <p class="mission-body">
        Beyond BARS Coaching is the framework. The Sober Rebel Club is the community. Together,
        they create a continuum of care for system-impacted women navigating major life transitions.
      </p>
    </div>
  </section>

  <!-- ── About Vanessa ─────────────────────────────────────────────── -->
  <section class="section">
    <div class="container about-vanessa">
      <div>
        <h2>👋 Hello, I'm Vanessa, AKA Coach Veeeee</h2>
        <p>
          I've been sober since December 9, 2020. I lived in group homes
          from ages 13–17 and experienced homelessness—experiences that shaped everything about my
          mission to help system-impacted women navigate major life transitions.
        </p>
        <p>
          As a certified Alcohol Recovery Coach, Herbalist, and Registered Yoga Teacher (RYT-500),
          I bring over two decades of holistic practice to every coaching relationship. I retired
          from my Massage Therapy career and poured all of that knowledge into this work.
        </p>
        <a href={`${base}program-details`} class="btn btn-primary" style="margin-top: 1.5rem;">Learn About The Program</a>
      </div>
      <div class="about-portrait">
        <Image src={VanessaImage} alt="Vanessa Ragains" width={900} loading="lazy"></Image>
      </div>
    </div>
  </section>

  <!-- ── What You'll Learn ──────────────────────────────────────────── -->
  <section class="section bg-section">
    <div class="container text-center">
      <h2 class="section-heading">🧠 What You'll Learn</h2>
      <div class="divider"></div>
      <div class="learn-grid grid-3" style="margin-top: 2.5rem;">
        <div class="card card-body">
          <div class="learn-icon">🎯</div>
          <h3>Clarify Your Goals</h3>
          <p>Receive a personalized, step-by-step Sober Rebel Plan that integrates your education
          and career journey, while maintaining a strong, authentic LinkedIn profile that reflects
          your growth and goals.</p>
        </div>
        <div class="card card-body">
          <div class="learn-icon">🏛️</div>
          <h3>Honor the 3 Pillars</h3>
          <p>You'll build supportive goals across Nourishment, Self-Care, and Personal
          Development—the three pillars that ground our work and create sustainable progress.</p>
        </div>
        <div class="card card-body">
          <div class="learn-icon">🧘</div>
          <h3>Cultivate Healthy Mobility</h3>
          <p>Through a thoughtful blend of herbal wellness and trauma-informed yoga, you'll develop
          a mobility practice that restores movement, supports nervous-system regulation, and helps
          your body feel safer, steadier, and more resilient.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAST Method ────────────────────────────────────────────────── -->
  <section class="section" id="fast-method">
    <div class="container text-center">
      <h2 class="section-heading">🧩 The F.A.S.T. Method</h2>
      <p class="section-sub">Healing happens through safety + repetition, not pressure.</p>
      <Image src={FastMethod} height="400" alt="FAST Method" class="fast-method-image"></Image>
      <div class="fast-grid grid-4">
        <div class="fast-card">
          <div class="fast-letter">F</div>
          <h3>Foundation</h3>
          <p>Nervous-system safety and daily rhythms that create stability.</p>
        </div>
        <div class="fast-card">
          <div class="fast-letter">A</div>
          <h3>Accountability</h3>
          <p>Supportive structure and reflective practices to keep you on track.</p>
        </div>
        <div class="fast-card">
          <div class="fast-letter">S</div>
          <h3>Support</h3>
          <p>Trauma-informed coaching and peer connection that meets you where you are.</p>
        </div>
        <div class="fast-card">
          <div class="fast-letter">T</div>
          <h3>Tools</h3>
          <p>Practical, repeatable practices you can reach for in any moment.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Board Members ──────────────────────────────────────────────── -->
  <section class="section bg-soft" id="board">
    <div class="container text-center">
      <h2 class="section-heading">🤝 Our Board</h2>
      <div class="divider"></div>
      <div class="board-grid" style="margin-top: 2.5rem;">
        <div class="board-member">
          <div class="board-photo">
            <Image src={VanessaImage} alt="Vanessa Ragains" width="300" loading="lazy"></Image>
          </div>
          <h3>Vanessa Ragains</h3>
          <p class="board-title">President &amp; Founder</p>
        </div>
        <div class="board-member">
          <div class="board-photo">
            <Image src={JessieImage} alt="Jessie Keck" width="300" loading="lazy"></Image>
          </div>
          <h3>Jessie Keck</h3>
          <p class="board-title">Treasurer</p>
        </div>
        <div class="board-member">
          <div class="board-photo">
            <Image src={HaileyImage} alt="Hailey Brock" width="300" loading="lazy"></Image>
          </div>
          <h3>Hailey Brock</h3>
          <p class="board-title">Board Member</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Free Resources ────────────────────────────────────────────── -->
  <section class="section" id="resources">
    <div class="container text-center">
      <h2 class="section-heading">🚀 Free Resources</h2>
      <p class="section-sub">Download these tools to start your journey today.</p>
      <div class="resources-grid grid-3">
        <!-- ── Holiday-season resources first ── -->
        <a href={`${base}downloads/holiday-dopamine-menu.pdf`} class="resource-card" target="_blank" rel="noopener">
          <div class="resource-icon">🎄</div>
          <p>Holiday Dopamine Menu &amp; F.A.S.T. Method Holiday Edition</p>
        </a>
        <a href={`${base}downloads/seasonal-recovery-toolkit.pdf`} class="resource-card" target="_blank" rel="noopener">
          <div class="resource-icon">🍂</div>
          <p>Seasonal Recovery Toolkit</p>
        </a>
        <a href={`${base}downloads/dopamine-menu.pdf`} class="resource-card" target="_blank" rel="noopener">
          <div class="resource-icon">⚗️</div>
          <p>Sober Rebel Dopamine Menu</p>
        </a>
        <a href={`${base}downloads/weekly-meal-planner.pdf`} class="resource-card" target="_blank" rel="noopener">
          <div class="resource-icon">🥗</div>
          <p>Weekly Meal Planner</p>
        </a>
        <a href={`${base}downloads/healthy-boundaries-cheat-sheet.pdf`} class="resource-card" target="_blank" rel="noopener">
          <div class="resource-icon">🛡️</div>
          <p>Healthy Boundaries Cheat Sheet</p>
        </a>
        <a href={`${base}downloads/chaos-to-calm-packet.pdf`} class="resource-card" target="_blank" rel="noopener">
          <div class="resource-icon">🌿</div>
          <p>Chaos to Calm Packet (Pranayama &amp; Yoga Sequences)</p>
        </a>
        <!-- ── Year-round resources ── -->
        <a href={`${base}downloads/first-90-days-chart.pdf`} class="resource-card" target="_blank" rel="noopener">
          <div class="resource-icon">📅</div>
          <p>First 90 Days: Body, Heart &amp; Mind Timeline</p>
        </a>
        <a href="https://vimeo.com/reviews/3525b5a9-eee1-49f5-b518-a6f61138735f/users/129237958/folders/4648951" class="resource-card" target="_blank" rel="noopener">
          <div class="resource-icon">🧘</div>
          <p>Yoga Video Library</p>
        </a>
        <a href={`${base}downloads/support-coaching-safety.pdf`} class="resource-card" target="_blank" rel="noopener">
          <div class="resource-icon">🛟</div>
          <p>Support, Coaching &amp; Safety</p>
        </a>
        <a href={`${base}downloads/3-brains-in-real-life.pdf`} class="resource-card" target="_blank" rel="noopener">
          <div class="resource-icon">🧠</div>
          <p>The 3 Brains in Real Life</p>
        </a>
        <a href={`${base}downloads/create-your-own-rebel-manifesto.pdf`} class="resource-card" target="_blank" rel="noopener">
          <div class="resource-icon">✊</div>
          <p>Create Your Own Rebel Manifesto</p>
        </a>
        <a href={`${base}downloads/sober-rebel-playlist-reflection.pdf`} class="resource-card" target="_blank" rel="noopener">
          <div class="resource-icon">🎵</div>
          <p>Sober Rebel Playlist Reflection Exercise</p>
        </a>
        <a href={`${base}downloads/foam-roller-charts.pdf`} class="resource-card" target="_blank" rel="noopener">
          <div class="resource-icon">🏋️</div>
          <p>Foam Roller Charts</p>
        </a>
        <a href={`${base}downloads/three-pillars-flowchart.png`} class="resource-card" target="_blank" rel="noopener">
          <div class="resource-icon">🌿</div>
          <p>The Three Pillars in Action</p>
        </a>
        <a href={`${base}downloads/vocational-training-resource-list.pdf`} class="resource-card" target="_blank" rel="noopener">
          <div class="resource-icon">📋</div>
          <p>Vocational Training Resource List Cheat Sheet</p>
        </a>
        <a href={`${base}downloads/linkedin-profile-networking-checklist.pdf`} class="resource-card" target="_blank" rel="noopener">
          <div class="resource-icon">💼</div>
          <p>LinkedIn Profile &amp; Networking Checklist</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── Donation CTA ───────────────────────────────────────────────── -->
  <section class="section donation-cta" style="background: var(--color-teal-subtle);">
    <div class="container text-center">
      <h2>Support the Mission</h2>
      <p>Each Sober Rebel is sponsored by generous donations from people who believe in this cause.</p>
      <a href={`${base}choose-your-impact`} class="btn btn-primary" style="margin-top: 1.5rem;">💛 Choose Your Impact</a>
    </div>
  </section>

<script>
  (function () {
    // Dec 1 2026 live windows (PT — adjust if needed)
    const sessions = [
      { start: '2026-12-01T09:15:00', end: '2026-12-01T09:45:00' },
      { start: '2026-12-01T11:00:00', end: '2026-12-01T11:30:00' },
      { start: '2026-12-01T14:00:00', end: '2026-12-01T14:30:00' },
      { start: '2026-12-01T18:15:00', end: '2026-12-01T18:45:00' },
    ];
    const wrap = document.getElementById('yt-live-wrap');
    if (!wrap) return;
    function check() {
      const now = new Date();
      const live = sessions.some(s => now >= new Date(s.start) && now <= new Date(s.end));
      wrap.classList.toggle('is-live', live);
    }
    check();
    setInterval(check, 30000);
  })();
</script>

</BaseLayout>

<style>
/* Hero */
.hero {
  background: linear-gradient(160deg, var(--color-brand-subtle) 0%, #fff 65%);
  padding-block: var(--space-16);
}
.hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-12);
  align-items: center;
}
.hero-intro { font-size: var(--text-xl); font-weight: 700; color: var(--color-brand-dark); margin-bottom: var(--space-4); }
.hero-text h1 { font-size: var(--text-4xl); margin-bottom: var(--space-4); }
.hero-tagline { font-size: var(--text-lg); color: var(--color-text-light); margin-bottom: var(--space-6); }
.hero-links a { margin-bottom: var(--space-1); }

/* Mission */
/* YouTube live embed */
.yt-live-wrap {
  margin-top: var(--space-8);
  max-width: 680px;
  margin-inline: auto;
  text-align: center;
}
.yt-live-schedule {
  font-size: var(--text-sm);
  color: var(--color-text-light);
  margin-bottom: var(--space-2);
}
.yt-live-label {
  font-size: var(--text-sm);
  color: #c00;
  font-weight: 700;
  margin-bottom: var(--space-3);
  letter-spacing: 0.02em;
  display: none;
}
.is-live .yt-live-label { display: block; }
.is-live .yt-live-schedule { display: none; }
.yt-live-frame {
  position: relative;
  padding-bottom: 56.25%; /* 16:9 */
  height: 0;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  background: #000;
}
.yt-live-frame iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: none;
}
.yt-live-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  margin-top: var(--space-4);
}
.yt-donate-btn {
  background: var(--color-gold);
  color: var(--color-green-dark);
  font-size: var(--text-lg);
  font-weight: 700;
  padding: var(--space-4) var(--space-10);
  border-radius: var(--radius-full);
  box-shadow: 0 4px 18px rgba(231,173,0,0.35);
  transition: background var(--transition), transform var(--transition), box-shadow var(--transition);
  letter-spacing: 0.01em;
}
.yt-donate-btn:hover {
  background: var(--color-gold-dark);
  transform: translateY(-2px);
  box-shadow: 0 6px 24px rgba(231,173,0,0.45);
  color: var(--color-green-dark);
}
.yt-live-link {
  font-size: var(--text-sm);
  color: var(--color-teal);
  text-decoration: underline;
}

/* Giving Tuesday spotlight */
.gt-spotlight { background: linear-gradient(135deg, #e8f0e8 0%, #fff8e1 100%); }
.gt-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-8);
  flex-wrap: wrap;
  border: 2px solid var(--color-gold);
  border-radius: var(--radius-xl);
  padding: var(--space-10) var(--space-12);
  background: rgba(255,255,255,0.8);
}
.gt-eyebrow {
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-teal);
  margin-bottom: var(--space-2);
}
.gt-card-text h2 { font-size: var(--text-2xl); margin-bottom: var(--space-2); }
.gt-card-text p { color: var(--color-text-light); margin: 0; max-width: 480px; }
.gt-card-cta { display: flex; gap: var(--space-3); flex-wrap: wrap; flex-shrink: 0; }
@media (max-width: 640px) {
  .gt-card { flex-direction: column; }
  .gt-card-cta { width: 100%; }
}

.mission-statement { font-size: var(--text-xl); font-family: var(--font-heading); font-style: italic; margin: var(--space-6) auto; max-width: 680px; }
.mission-body { max-width: 620px; margin-inline: auto; color: var(--color-text-light); }

/* About Vanessa */
.about-vanessa { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); align-items: center; }
.about-vanessa h2 { font-size: var(--text-3xl); margin-bottom: var(--space-4); }
.about-vanessa p { color: var(--color-text-light); margin-bottom: var(--space-4); }
.about-portrait img { border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }

/* Learn */
.learn-icon { font-size: 2.5rem; margin-bottom: var(--space-3); }
.learn-grid .card-body h3 { margin-bottom: var(--space-2); }

/* FAST */
.fast-grid { margin-top: var(--space-10); }
.fast-method-image { margin: 0 auto; }
.fast-card {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  box-shadow: var(--shadow-md);
  text-align: center;
}
.fast-letter {
  font-family: var(--font-heading);
  font-size: var(--text-5xl);
  font-weight: 700;
  color: var(--color-brand);
  line-height: 1;
  margin-bottom: var(--space-3);
}
.fast-card h3 { font-size: var(--text-xl); margin-bottom: var(--space-2); }
.fast-card p { color: var(--color-text-light); font-size: var(--text-sm); }

/* Board */
.board-grid { display: flex; justify-content: center; gap: var(--space-10); flex-wrap: wrap; }
.board-member { text-align: center; }
.board-photo {
  width: 140px;
  height: 140px;
  border-radius: 50%;
  overflow: hidden;
  margin: 0 auto var(--space-4);
  border: 3px solid var(--color-brand-light);
}
.board-photo img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
.board-member h3 { font-size: var(--text-lg); margin-bottom: var(--space-1); }
.board-title { color: var(--color-text-muted); font-size: var(--text-sm); }

/* Resources */
.resources-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin-top: var(--space-8); }
.resource-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-5);
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  color: var(--color-text);
  text-decoration: none;
  border: 1px solid var(--color-brand-subtle);
  transition: all var(--transition);
  text-align: center;
  font-size: var(--text-sm);
}
.resource-card:hover { border-color: var(--color-brand); box-shadow: var(--shadow-md); transform: translateY(-2px); color: var(--color-brand-dark); }
.resource-icon { font-size: 1.75rem; }

/* Donation CTA */
.donation-cta { padding-block: var(--space-12); }
.donation-cta h2 { font-size: var(--text-3xl); color: var(--color-teal-dark); margin-bottom: var(--space-4); }
.donation-cta p { color: var(--color-text-light); font-size: var(--text-lg); max-width: 560px; margin-inline: auto; }

/* Responsive */
@media (max-width: 768px) {
  .hero-inner, .about-vanessa { grid-template-columns: 1fr; }
  .hero-text h1 { font-size: var(--text-3xl); }
  .hero-image { display: none; }
  .resources-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 480px) {
  .resources-grid { grid-template-columns: 1fr; }
}
</style>
