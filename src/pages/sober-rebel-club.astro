---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Sober Rebel Club for Women | Beyond BARS Coaching"
  description="The Sober Rebel Club for Women is an alcohol-free community for system-impacted women choosing sobriety, connection, and growth — online and IRL in the Bay Area."
>

  <!-- ── Countdown ticker ──────────────────────────────────────────── -->
  <div class="ticker-bar">
    <div class="ticker-inner">
      <span class="ticker-label">🗓 Next Sober Rebel Event:</span>
      <span id="countdown" class="ticker-countdown">Loading…</span>
    </div>
  </div>

  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <section class="section-sm bg-soft text-center">
    <div class="container">
      <h1>The Sober Rebel Club for Women</h1>
      <p class="page-sub">
        An alcohol-free community for system-impacted women choosing sobriety,
        nervous-system safety, movement, and real connection — online + IRL in the Bay Area.
      </p>
      <div class="divider"></div>
    </div>
  </section>

  <!-- ── Welcome Video ─────────────────────────────────────────────── -->
  <section class="section">
    <div class="container text-center">
      <h2 class="section-heading">👋 Welcome to the Club</h2>
      <p class="section-sub">A personal message from Coach Veeeee</p>
      <div class="video-wrap">
        <iframe
          src="https://player.vimeo.com/video/1158987277?h=37eea3eae3&title=0&byline=0&portrait=0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
          title="Sober Rebel Club for Women Welcome Video"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ── What is the SRC ───────────────────────────────────────────── -->
  <section class="section bg-soft">
    <div class="container text-center">
      <h2 class="section-heading">🌿 What Is the Sober Rebel Club?</h2>
      <div class="divider"></div>
      <div class="src-pillars grid-3" style="margin-top: 2.5rem;">
        <div class="card card-body src-pillar">
          <div class="pillar-icon">🎙️</div>
          <h3>Podcast & Community</h3>
          <p>Stay connected through the Sober Rebel Podcast and a growing community of women who get it.</p>
        </div>
        <div class="card card-body src-pillar">
          <div class="pillar-icon">📅</div>
          <h3>Events & Gatherings</h3>
          <p>In-person Bay Area meetups and online gatherings — with SAFE transportation provided to and from activities.</p>
        </div>
        <div class="card card-body src-pillar">
          <div class="pillar-icon">✈️</div>
          <h3>Retreat in Puerto Vallarta</h3>
          <p>Coming soon — 4-night retreat in Puerto Vallarta. A sober celebration of how far you've come.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Challenges ────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container text-center">
      <h2 class="section-heading">🔥 Sober Rebel Challenges</h2>
      <p class="section-sub">Monthly challenges to keep you moving, growing, and connected.</p>
      <div class="challenges-grid grid-3" style="margin-top: 2rem;">
        <div class="challenge-card card card-body">
          <div class="challenge-icon">🧘</div>
          <h3>Yoga-Shred Challenge</h3>
          <p>A 30-day blend of yoga and strength movement to build your body and steady your mind.</p>
        </div>
        <div class="challenge-card card card-body">
          <div class="challenge-icon">📚</div>
          <h3>Book Club</h3>
          <p>Read together, reflect together. Monthly titles chosen to support your sobriety and growth journey.</p>
        </div>
        <div class="challenge-card card card-body">
          <div class="challenge-icon">✨</div>
          <h3>More Coming Soon</h3>
          <p>New challenges drop regularly. Stay tuned — and bring your rebel energy.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Calendar ──────────────────────────────────────────────────── -->
  <section class="section bg-soft">
    <div class="container text-center">
      <h2 class="section-heading">📅 Upcoming Events</h2>
      <p class="section-sub">Check back often — new events are added regularly.</p>
      <div class="calendar-wrap">
        <iframe
          src="https://calendar.google.com/calendar/embed?src=3ff40b04552d5439a46741cbeeda7f088f97d63364d3f882e56669bec454f7e1%40group.calendar.google.com&ctz=America%2FLos_Angeles"
          style="border: 0"
          width="100%"
          height="600"
          frameborder="0"
          scrolling="no"
          title="Sober Rebel Club Events Calendar"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ── Retreat Teaser ────────────────────────────────────────────── -->
  <section class="section retreat-section">
    <div class="container text-center">
      <div class="retreat-inner">
        <div class="retreat-emoji">🌺</div>
        <h2>Puerto Vallarta Retreat — Coming Soon</h2>
        <p>
          Imagine 4 nights in paradise with your Sober Rebel sisters. Movement, healing,
          celebration, and zero alcohol needed. This is what sobriety gets to look like.
        </p>
        <a href="/book-a-call" class="btn btn-primary" style="margin-top: 1.5rem;">
          Get Notified — Book a Call
        </a>
      </div>
    </div>
  </section>

  <!-- ── Join CTA ──────────────────────────────────────────────────── -->
  <section class="section-sm text-center" style="background: var(--color-teal-subtle);">
    <div class="container">
      <h2 class="section-heading" style="color: var(--color-teal-dark);">Ready to Join the Club?</h2>
      <p style="color: var(--color-text-light); max-width: 560px; margin-inline: auto; margin-bottom: var(--space-6);">
        Fill out the registration form and Coach Veeeee will be in touch.
      </p>
      <a
        href="https://docs.google.com/forms/d/e/1FAIpQLSfy1H7JxP4Bt5CCJz8qJ77Eb5kz5uNmn7GHEz7FX4L98ybReg/viewform"
        target="_blank"
        rel="noopener"
        class="btn btn-primary"
      >
        Fill Out Registration Form
      </a>
    </div>
  </section>

</BaseLayout>

<style>
.page-sub { color: var(--color-text-light); font-size: var(--text-lg); margin-top: var(--space-3); max-width: 600px; margin-inline: auto; }

/* Ticker */
.ticker-bar {
  background: var(--color-green-dark);
  color: #fff;
  padding: 0.6rem var(--space-4);
  text-align: center;
  font-size: var(--text-sm);
  font-weight: 700;
  letter-spacing: 0.04em;
}
.ticker-inner { display: flex; align-items: center; justify-content: center; gap: var(--space-3); flex-wrap: wrap; }
.ticker-label { color: var(--color-gold); text-transform: uppercase; font-size: var(--text-xs); letter-spacing: 0.08em; }
.ticker-countdown { color: #fff; font-family: var(--font-heading); font-size: var(--text-base); }

/* Video */
.video-wrap {
  position: relative;
  padding-bottom: 56.25%;
  height: 0;
  overflow: hidden;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  max-width: 860px;
  margin: 0 auto;
}
.video-wrap iframe {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  border: 0;
}

/* Pillars */
.src-pillar { text-align: center; }
.pillar-icon { font-size: 2.5rem; margin-bottom: var(--space-3); }
.src-pillar h3 { margin-bottom: var(--space-2); color: var(--color-teal); }
.src-pillar p { color: var(--color-text-light); font-size: var(--text-sm); }

/* Challenges */
.challenge-card { text-align: center; }
.challenge-icon { font-size: 2.5rem; margin-bottom: var(--space-3); }
.challenge-card h3 { margin-bottom: var(--space-2); color: var(--color-brand-dark); }
.challenge-card p { color: var(--color-text-light); font-size: var(--text-sm); }

/* Calendar */
.calendar-wrap {
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  border: 1px solid var(--color-brand-subtle);
  max-width: 900px;
  margin: 0 auto;
}

/* Retreat */
.retreat-section { background: var(--color-green-dark); }
.retreat-inner { max-width: 640px; margin: 0 auto; }
.retreat-emoji { font-size: 3rem; margin-bottom: var(--space-4); }
.retreat-section h2 { color: var(--color-gold); font-size: var(--text-3xl); margin-bottom: var(--space-4); }
.retreat-section p { color: rgba(255,255,255,0.85); font-size: var(--text-lg); }
</style>

<script>
  // Countdown timer — update TARGET_DATE to the next event date/time
  const TARGET_DATE = new Date('2025-08-01T10:00:00-07:00'); // ← update this

  function updateCountdown() {
    const now = new Date();
    const diff = TARGET_DATE.getTime() - now.getTime();
    const el = document.getElementById('countdown');
    if (!el) return;

    if (diff <= 0) {
      el.textContent = '🎉 Event is happening now!';
      return;
    }

    const days    = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours   = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((diff % (1000 * 60)) / 1000);

    el.textContent = `${days}d ${hours}h ${minutes}m ${seconds}s`;
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>
