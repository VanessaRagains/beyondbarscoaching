---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Your First 90 Days Beyond BARS Workbook"
  description="A 90-day coaching workbook and planner for system-impacted women choosing sobriety and stability. Built on the F.A.S.T. Method — $22.99, buy one give one."
>

  <!-- Hero -->
  <section class="hero-workbook">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-cover">
          <img src={`${base}img/workbook-cover.png`} alt="Your First 90 Days Beyond BARS Workbook cover" />
        </div>
        <div class="hero-text">
          <p class="hero-eyebrow">The Beyond BARS Coaching Workbook</p>
          <h1>Your First 90 Days Beyond BARS</h1>
          <p class="hero-sub">
            A 90-day coaching workbook + planner for system-impacted women
            transitioning from incarceration, rehab, or group homes — and
            choosing sobriety, stability, and a life with purpose.
          </p>
          <div class="price-row">
            <span class="price">$22.99</span>
            <span class="price-note">Every purchase funds a workbook for someone who can't afford one.</span>
          </div>
          <a href="https://svc.lulu.com/?items=ad105fce-dd5a-4813-9ba6-ea160f9cfa72" target="_blank" rel="noopener" class="btn btn-primary btn-lg">
            📖 Buy the Workbook
          </a>
          <p class="price-sub">Fulfilled &amp; shipped by Lulu Publishing · Printed on demand</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Inside -->
  <section class="section bg-soft">
    <div class="container text-center">
      <h2 class="section-heading">What's Inside Your Workbook</h2>
      <div class="divider"></div>
      <div class="inside-grid grid-3">
        <div class="inside-card card card-body accent-teal">
          <div class="inside-icon">🧠</div>
          <h3>Coaching Exercises</h3>
          <p>Science-backed tools for behavior change, nervous-system regulation, and building self-trust — one step at a time.</p>
        </div>
        <div class="inside-card card card-body accent-purple">
          <div class="inside-icon">📅</div>
          <h3>Daily Planner</h3>
          <p>90 days of structured planning pages so you always know what's next — even when everything else feels uncertain.</p>
        </div>
        <div class="inside-card card card-body accent-lavender">
          <div class="inside-icon">✍️</div>
          <h3>Journal Prompts</h3>
          <p>Guided prompts at every milestone to help you process what's happening in your body, heart, and mind.</p>
        </div>
        <div class="inside-card card card-body accent-gold">
          <div class="inside-icon">🧘</div>
          <h3>Yoga Sequences</h3>
          <p>Gentle movement practices designed to support nervous-system safety and build a body-based recovery routine.</p>
        </div>
        <div class="inside-card card card-body accent-sage">
          <div class="inside-icon">🌬️</div>
          <h3>Breathing Exercises</h3>
          <p>Pranayama and breath-based tools for moments when a craving, a hard emotion, or a stressful day hits.</p>
        </div>
        <div class="inside-card card card-body accent-green">
          <div class="inside-icon">🎁</div>
          <h3>Bonuses &amp; Resources</h3>
          <p>Extra tools, cheat sheets, and community resources to support your rebel journey beyond the 90 days.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAST Method -->
  <section class="section">
    <div class="container">
      <div class="fast-wrap">
        <div class="fast-text">
          <h2>Built on the <span class="brand-highlight">F.A.S.T. Method</span></h2>
          <p>Everything in this workbook maps back to four pillars that support lasting recovery:</p>
          <ul class="fast-list">
            <li><strong>F — Foundation</strong> Nervous-system safety, daily rhythms, and basic needs — including Nourishment, Self-Care, and Personal Development.</li>
            <li><strong>A — Accountability</strong> Supportive structure, reflection, and follow-through. A shared calendar and one 60-minute call per month.</li>
            <li><strong>S — Support</strong> Trauma-informed coaching, peer connection, and community care. Weekly check-ins and text-based coaching between calls.</li>
            <li><strong>T — Tools</strong> Practical, repeatable practices that regulate the body and build resilience — including everything in this workbook.</li>
          </ul>
        </div>
        <div class="fast-cta card card-body accent-brand">
          <p class="fast-price-label">One workbook · 90 days of support</p>
          <div class="fast-price">$22.99</div>
          <p class="fast-give">Buy one · Give one</p>
          <p class="fast-give-sub">Every purchase funds a workbook for a woman in transition who can't afford one.</p>
          <a href="https://svc.lulu.com/?items=ad105fce-dd5a-4813-9ba6-ea160f9cfa72" target="_blank" rel="noopener" class="btn btn-primary">
            📖 Buy the Workbook
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section bg-soft">
    <div class="container text-center">
      <h2 class="section-heading">What Rebels Are Saying</h2>
      <div class="divider"></div>
      <div class="testimonials-grid grid-2">
        <blockquote class="testimonial-card card card-body">
          <p>"Would recommend this workbook to anyone new to their recovery journey."</p>
        </blockquote>
        <blockquote class="testimonial-card card card-body">
          <p>"I learned that I'm not alone in the way that I think and feel."</p>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section text-center">
    <div class="container">
      <h2 class="section-heading">Ready to Start Your Rebel Journey?</h2>
      <p class="cta-sub">Less than 26 cents a day for 90 days of real support.</p>
      <a href="https://svc.lulu.com/?items=ad105fce-dd5a-4813-9ba6-ea160f9cfa72" target="_blank" rel="noopener" class="btn btn-primary btn-lg">
        📖 Buy the Workbook — $22.99
      </a>
      <p class="cta-note">Shipped directly to your door via Lulu Publishing.</p>
    </div>
  </section>

</BaseLayout>

<style>
/* Hero */
.hero-workbook {
  background: linear-gradient(160deg, var(--color-brand-subtle) 0%, #fff 70%);
  padding-block: var(--space-16);
}
.hero-inner {
  display: grid;
  grid-template-columns: 340px 1fr;
  gap: var(--space-12);
  align-items: center;
}
.hero-cover img {
  width: 100%;
  max-width: 320px;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}
.hero-eyebrow {
  font-size: var(--text-sm);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-teal);
  margin-bottom: var(--space-2);
}
.hero-text h1 { font-size: var(--text-4xl); margin-bottom: var(--space-4); }
.hero-sub { font-size: var(--text-lg); color: var(--color-text-light); margin-bottom: var(--space-6); max-width: 520px; }
.price-row {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  margin-bottom: var(--space-6);
  flex-wrap: wrap;
}
.price {
  font-family: var(--font-heading);
  font-size: var(--text-4xl);
  font-weight: 700;
  color: var(--color-brand-dark);
}
.price-note {
  font-size: var(--text-sm);
  color: var(--color-text-light);
  max-width: 220px;
  line-height: 1.4;
}
.btn-lg { font-size: var(--text-lg); padding: 0.85rem 2rem; }
.price-sub {
  margin-top: var(--space-3);
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

/* What's Inside */
.inside-grid { margin-top: var(--space-10); }
.inside-card { text-align: left; }
.inside-icon { font-size: 2rem; margin-bottom: var(--space-3); }
.inside-card h3 { font-size: var(--text-lg); margin-bottom: var(--space-2); }
.inside-card p { color: var(--color-text-light); font-size: var(--text-sm); }

.accent-teal     { border-left: 5px solid var(--color-teal); }
.accent-purple   { border-left: 5px solid var(--color-brand-dark); }
.accent-lavender { border-left: 5px solid var(--color-brand); }
.accent-gold     { border-left: 5px solid var(--color-gold); }
.accent-sage     { border-left: 5px solid var(--color-sage); }
.accent-green    { border-left: 5px solid var(--color-green-dark); }
.accent-brand    { border-left: 5px solid var(--color-brand); }

/* FAST Method */
.fast-wrap {
  display: grid;
  grid-template-columns: 1fr 320px;
  gap: var(--space-12);
  align-items: start;
}
.fast-text h2 { font-size: var(--text-3xl); margin-bottom: var(--space-4); }
.fast-text p { color: var(--color-text-light); margin-bottom: var(--space-4); }
.brand-highlight { color: var(--color-brand); }
.fast-list { list-style: none; display: flex; flex-direction: column; gap: var(--space-4); }
.fast-list li { color: var(--color-text-light); padding-left: var(--space-4); border-left: 3px solid var(--color-brand-light); }
.fast-list strong { color: var(--color-text); display: block; margin-bottom: var(--space-1); }

.fast-cta { text-align: center; position: sticky; top: var(--space-8); }
.fast-price-label { font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-teal); margin-bottom: var(--space-2); }
.fast-price { font-family: var(--font-heading); font-size: var(--text-4xl); font-weight: 700; color: var(--color-brand-dark); margin-bottom: var(--space-2); }
.fast-give { font-weight: 700; color: var(--color-brand); font-size: var(--text-lg); margin-bottom: var(--space-1); }
.fast-give-sub { font-size: var(--text-sm); color: var(--color-text-light); margin-bottom: var(--space-5); }

/* Testimonials */
.testimonials-grid { margin-top: var(--space-8); }
.testimonial-card p { font-size: var(--text-lg); font-style: italic; color: var(--color-text-light); }
.testimonial-card { border-left: 5px solid var(--color-brand); }

/* Final CTA */
.cta-sub { font-size: var(--text-lg); color: var(--color-text-light); margin-bottom: var(--space-6); }
.cta-note { margin-top: var(--space-3); font-size: var(--text-sm); color: var(--color-text-muted); }

@media (max-width: 900px) {
  .hero-inner { grid-template-columns: 1fr; }
  .hero-cover { text-align: center; }
  .hero-cover img { max-width: 260px; }
  .fast-wrap { grid-template-columns: 1fr; }
  .fast-cta { position: static; }
}
@media (max-width: 560px) {
  .hero-text h1 { font-size: var(--text-3xl); }
}
</style>
